# ResearchMap Environment Configuration

# Directory Paths
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
MODELS_DIR=models
REPORTS_DIR=reports

# Production Retrieval & Sentence Selection Settings (Configuration C)
BM25_TOP_K_DOCS=10
BM25_TOP_K_SENTENCES=4
BM25_DOC_SCORE_WEIGHT=0.35
BM25_MAX_SENTENCES_PER_DOC=2

# NLI Cross-Encoder Model & Inference Settings
# Note: The backend automatically detects and uses the production fine-tuned checkpoint
# (models/finetuned_nli) if present on disk. NLI_MODEL_NAME specifies the base pretrained
# model fallback (downloaded automatically from HuggingFace on fresh clones before training).
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-small
DEVICE=auto
RANDOM_SEED=42

# Entailment Decision Thresholds
ENTAIL_THRESHOLD=0.50
CONTRADICT_THRESHOLD=0.50
